{{ 'section-image-with-text.css' |  asset_url |  stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'

  if section.location == 'template' and section.index <= 2
    assign image_loading = 'eager'
  endif

  if section.location == 'template' and section.index == 1
    assign image_fetchpriority = 'high'
  endif
-%}

<div class="section-image-with-text color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="container">
    <div class="section-image-with-text__wrap">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'image' %}
            <div class="image-item {{ block.settings.aspect_ratio }}">
              <div class="image">
                <div class="image__wrap">
                  {% if block.settings.img != blank %}
                    {% case block.settings.aspect_ratio %}
                        {% when 'image-ratio-626-439' %}
                        {% assign image_sizes = '(min-width: 1252px) 626px, (min-width: 750px) 50vw, 100vw' %}
                        {% when 'image-ratio-640-519' %}
                        {% assign image_sizes = '(min-width: 1280px) 640px, (min-width: 750px) 50vw, 100vw' %}
                        {% when 'image-ratio-688-620' %}
                        {% assign image_sizes = '(min-width: 1376px) 688px, (min-width: 750px) 50vw, 100vw' %}
                    {% endcase %}

                    {{
                        block.settings.img
                        | image_url: width: 1400
                        | image_tag:
                        widths: '320, 480, 626, 640, 688, 750, 900, 1100, 1252, 1280, 1376, 1400',
                        sizes: image_sizes,
                        loading: image_loading,
                        fetchpriority: image_fetchpriority,
                        alt: block.settings.img.alt
                    }}
                {% endif %}
                </div>
              </div>
            </div>

          {% when 'content' %}
            <div class="content">
              <div class="content__wrap">
                {% if block.settings.title != blank %}
                  <div class="title">
                    <{{ block.settings.title_tag }}>
                      {{ block.settings.title }}
                    </{{ block.settings.title_tag }}>
                  </div>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="text">
                    {{ block.settings.text }}
                  </div>
                {% endif %}

                {% if block.settings.btn_name != blank and block.settings.url != blank %}
                  <div class="btn__wrap">
                    <a class="btn" href="{{ block.settings.url }}">
                      <span>
                        {{ block.settings.btn_name }}
                      </span>
                    </a>
                  </div>
                {% endif %}
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Section image with text",
  "tag": "section",
  "class": "section new-shopify-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "padding top",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "padding bottom",
      "default": 15
    }
  ],
  "blocks": [
    {
        "name": "image",
        "type":"image",
        "limit":1,
        "settings": [
            {
                "type": "image_picker",
                "id":"img",
                "label": "image"
            },
            {
                "type": "select",
                "id": "aspect_ratio",
                "label": "Image aspect ratio",
                "options": [
                    {
                    "value": "image-ratio-626-439",
                    "label": "626 × 439"
                    },
                    {
                    "value": "image-ratio-640-519",
                    "label": "640 × 519"
                    },
                    {
                    "value": "image-ratio-688-620",
                    "label": "688 × 620"
                    }
                ],
                "default": "image-ratio-626-439"
            }
        ]
    },
    {
        "name": "content",
        "type":"content",
        "limit":1,
        "settings": [
            {
                "type": "text",
                "id":"title",
                "label": "title",
                "default":"Your trusted insider lens & home of the Top Ten"
            },
            {
            "type": "select",
            "id": "title_tag",
            "label": "Title tag",
            "options": [
                {
                "value": "h2",
                "label": "H2"
                },
                {
                "value": "h3",
                "label": "H3"
                }
            ],
            "default": "h2"
            },
            {
                "type":"richtext",
                "id":"text",
                "label": "text",
                "default":"<p>Through features with founders and tastemakers, T² distills personal taste into actionable discovery across products, places, and rituals—bridging aspiration with application.</p>"
            },
            {
                "type": "text",
                "id":"btn_name",
                "label": "btn name",
                "default": "Learn more →"
            },
            {
                "type": "url",
                "id":"url",
                "label": "url"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Section image with text"
    }
  ]
}
{% endschema %}