{{ 'section-featured.css' |  asset_url |  stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="section-featured  color-{{ section.settings.color_scheme }}">
    <div class="section-featured-body">
        <div class="container">
        <div class="section-featured__wrap section-{{ section.id }}-padding">
            {% if section.settings.title != blank %}
                <div class="title">
                    <h2>
                        {{ section.settings.title }}
                    </h2>
                </div>
            {% endif %}
            <div class="content">
                <div class="left">
                    <div class="left__wrap">
                        {% for block in section.blocks %}
                            {% case block.type %}
                                {% when 'content' %}
                                    <div class="content-item">
                                        {% if  block.settings.title != blank %}
                                            <div class="title" >
                                                <h3>
                                                    {{ block.settings.title }}
                                                </h3>
                                            </div>
                                        {% endif %}
                                        {% if block.settings.text != blank %}
                                            <div class="text">
                                                <p>
                                                    {{ block.settings.text }}
                                                </p>
                                            </div>
                                        {% endif %}
                                        {% if block.settings.btn_name != blank and block.settings.url != blank %}
                                            <div class="btn__wrap">
                                                <a class="btn" href="{{ block.settings.url }}"> 
                                                    <span>
                                                        {{ block.settings.btn_name }} 
                                                    </span>
                                                </a>
                                            </div>
                                        {% endif %}
                                    </div>
                                {% when 'image-text' %}
                                    <div class="image-text">
                                        {% if block.settings.img != blank %}
                                            <div class="image">
                                                <div class="image__wrap">
                                                    <img src="{{ block.settings.img |  image_url: width: block.settings.img.width }}" alt="{% if block.settings.img.alt != blank %}{{block.settings.img.alt}}{% else %}{{block.settings.title}}{% endif %}">
                                                </div>
                                            </div>
                                        {% endif %}
                                        {% if block.settings.title != blank %}
                                            <div class="title">
                                                <h3>
                                                    {{ block.settings.title }}
                                                </h3>
                                            </div>
                                        {% endif %}
                                        {% if block.settings.subtitle != blank %}
                                            <div class="subtitle">
                                                <p>
                                                    {{ block.settings.subtitle }}
                                                </p>
                                            </div>
                                        {% endif %}
                                    </div>
                            {% endcase %}
                        {% endfor %}
                    </div>
                </div>
                {% if section.settings.img != blank %}
                    <div class="right">
                        <div class="right__wrap">
                            <div class="image">
                                <div class="image__wrap">   
                                    <picture>
                                        <img
                                        src="{{ section.settings.img | image_url: width: section.settings.img.width }}"
                                        width="{{ section.settings.img.width }}"
                                        alt="{{ section.settings.img.alt | escape }}"
                                        >
                                    </picture>    
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    </div>
</div>

{% schema %}
{
  "name": "Section featured",
  "tag": "section",
  "class": "section new-shopify-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "color scheme",
      "default": "scheme-1"
    },
    {
        "type": "image_picker",
        "id":"img",
        "label":"image"
    },
    {
        "type": "text",
        "id":"title",
        "label": "title",
        "default": "FEATUREd top ten"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "padding top",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "padding bottom",
      "default": 15
    }
  ],
  "blocks": [
    {
        "type": "image-text",
        "name":"image with text",
        "limit":1,
        "settings": [
            {
                "type": "image_picker",
                "id":"img",
                "label":"image"
            },
            {
                "type": "text",
                "id":"title",
                "label": "title",
                "default":"Chandon"
            },
            {
                "type": "text",
                "id":"subtitle",
                "label":"subtitle",
                "default":"Rose Brut"
            }
        ]
    },
    {
        "type": "content",
        "name":"content",
        "limit":1,
        "settings": [
            {
                "type": "text",
                "id":"title",
                "label": "title",
                "default":"Kate berry"
            },
            {
                "type": "text",
                "id":"text",
                "label": "text",
                "default":"Lorem ipsum dolor sit amet consectetur. Ut tortor aliquet viverra pulvinar tellus. Felis justo congue aliquet ultricies dui egestas consectetur scelerisque."
            },
            {
                "type": "text",
                "id":"btn_name",
                "label": "btn name",
                "default": "VIEW more → "
            },
            {
                "type": "url",
                "id":"url",
                "label": "url"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Section top ten"
    }
  ]
}
{% endschema %}