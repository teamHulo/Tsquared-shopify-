{{ 'section-split-hero.css' |  asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="section-split-hero  color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    <div class="container">
        <div class="section-split-hero__wrap">
            <div class="title">
                <h2 class="h1">
                    {{ section.settings.title }}
                </h2>
            </div>
            <div class="grid-blocks">
                {% for block in section.blocks %}
                    {% case block.type %}
                        {% when 'image' %}
                            <div class="image-item">
                                <div class="image">
                                    <div class="image__wrap {% if block.settings.img_1 != blank and block.settings.img_2 != blank %} image__wrap-split {% endif %}">
                                        {% if block.settings.img_1 != blank %}
                                            <img src="{{ block.settings.img_1 |  image_url: width: block.settings.img_1.width }}" alt="{{ block.settings.img_1.alt }}">
                                        {% endif %}
                                        {% if block.settings.img_2 != blank %}
                                            <img src="{{ block.settings.img_2 |  image_url: width: block.settings.img_2.width }}" alt="{{ block.settings.img_2.alt }}">
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% when 'content' %}
                            <div class="content">
                                <div class="content__wrap">
                                    {% if  block.settings.title != blank %}
                                        <div class="title" >
                                            <h3 class="h4">
                                                {{ block.settings.title }}
                                            </h3>
                                        </div>
                                    {% endif %}
                                    {% if block.settings.text != blank %}
                                        <div class="text">
                                            <p>
                                                {{ block.settings.text }}
                                            </p>
                                        </div>
                                    {% endif %}
                                    {% if block.settings.btn_name_1 != blank and block.settings.url_1 != blank or block.settings.btn_name_2 != blank and block.settings.url_2 != blank %}
                                        <div class="btn__wrap">
                                            {% if block.settings.btn_name_1 != blank and block.settings.url_1 != blank %}
                                                <a class="btn-secondary" href="{{ block.settings.url_1 }}"> 
                                                    <span>
                                                        {{ block.settings.btn_name_1 }} 
                                                    </span>
                                                </a>
                                            {% endif %}
                                            {% if block.settings.btn_name_2 != blank and block.settings.url_2 != blank %}
                                                <a class="btn-secondary" href="{{ block.settings.url_2 }}"> 
                                                    <span>
                                                        {{ block.settings.btn_name_2 }} 
                                                    </span>
                                                </a>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                    {% endcase %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Section split hero",
  "tag": "section",
  "class": "section new-shopify-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "color scheme",
      "default": "scheme-1"
    },
    {
        "type": "text",
        "id":"title",
        "label": "title",
        "default":"the top ten format"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "padding top",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "padding bottom",
      "default": 15
    }
  ],
  "blocks": [
    {
        "name": "images",
        "type":"image",
        "limit":1,
        "settings": [
            {
                "type": "image_picker",
                "id":"img_1",
                "label": "image 1"
            },
            {
                "type": "image_picker",
                "id":"img_2",
                "label": "image 2"
            }
        ]
    },
    {
        "name": "content",
        "type":"content",
        "limit":1,
        "settings": [
            {
                "type": "text",
                "id":"title",
                "label": "title",
                "default":"Lorem ipsum dolor sit amet consectetur. Netus felis consequat scelerisque sollicitudin natoque. Purus quis pellentesque volutpat dui convallis. Scelerisque velit purus ut consequat porttitor sociis risus."
            },

            {
                "type":"text",
                "id":"text",
                "label": "text",
                "default":"Think: raw honey from a small-batch maker, the vintage Levi’s you finally found, the one song you never skip."
            },
            {
                "type": "text",
                "id":"btn_name_1",
                "label": "btn name 1",
                "default": "Learn more →"
            },
            {
                "type": "url",
                "id":"url_1",
                "label": "url 1"
            },
            {
                "type": "text",
                "id":"btn_name_2",
                "label": "btn name 2",
                "default": "Learn more →"
            },
            {
                "type": "url",
                "id":"url_2",
                "label": "url 2"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Section split hero"
    }
  ]
}
{% endschema %}