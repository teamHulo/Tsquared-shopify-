{{ 'section-latest-top-tens.css' | asset_url | stylesheet_tag }}

<style>
  #section--{{section.id}} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom}}px;
  }
  @media (max-width: 767px) {
      #section--{{section.id}} {
          padding-top: {{ section.settings.padding_top_mobile }}px;
          padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }
  }
</style>

<latest-top-tens id="section--{{ section.id }}" class="top-tens__wrapper">
  {% if section.settings.title != blank %}
    <h2 class="title">{{ section.settings.title }}</h2>
  {% endif %}
  <div class="video__contents">
    {% for block in section.blocks %}
      <div class="video__wrapper">
        <a href="{{ block.settings.link }}">
        <img src="{{ block.settings.video_poster | img_url: 'master' }}">
        <div class="text__wrapper">
          {% if block.settings.title != blank %}
            <p class="title">{{ block.settings.title }}</p>
          {% endif %}
          {% if block.settings.subtitle != blank %}
            <p class="subtitle">{{ block.settings.subtitle }}</p>
          {% endif %}
        </div>
        </a>
      </div>
    {% endfor %}
  </div>
</latest-top-tens>

{% schema %}
{
  "name": "Latest top tens",
  "class": "latest-top-tens",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top on mobile",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom on mobile",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "image-item",
      "name": "image item",
      "settings": [
        {
          "type": "image_picker",
          "id": "video_poster",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Latest top tens"
    }
  ]
}
{% endschema %}
