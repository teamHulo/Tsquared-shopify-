{{ 'section-marquee-logo.css' |  asset_url |  stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{% capture marquee_items %}
  {% for block in section.blocks %}
    {% assign responsive_width = block.settings.max_width
      | times: 100.0
      | divided_by: 1280
    %}

    {% assign responsive_height = block.settings.max_height
      | times: 100.0
      | divided_by: 1280
    %}

    {% if block.settings.icon != blank %}
      <div class="item" {{ block.shopify_attributes }} style="--width-icon:clamp(
            calc({{- block.settings.max_width -}}px * 0.55),
            {{- responsive_width -}}vw,
            {{- block.settings.max_width -}}px
          );">
        <div
          class="image"  
        >
          <div
            class="image__wrap"
            style="padding-top:clamp(
              calc({{- block.settings.max_height -}}px * 0.55),
              {{- responsive_height -}}vw,
              {{- block.settings.max_height -}}px
            );"
          >
            <img
              src="{{ block.settings.icon | image_url: width: block.settings.icon.width }}"
              alt="{{ block.settings.icon.alt | escape }}"
              width="{{ block.settings.icon.width }}"
              height="{{ block.settings.icon.height }}"
              loading="lazy"
            >
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
{% endcapture %}

{% capture marquee_content %}
  <div class="content">
    {{ marquee_items }}
    {{ marquee_items }}
  </div>
{% endcapture %}

<div class="section-marquee-logo color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="marquee">
    <div class="marquee__wrap">
      {{ marquee_content }}
      {{ marquee_content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Section marquee ",
  "class":"new-shopify-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "padding top",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "padding bottom",
      "default": 15
    }
  ],
  "blocks": [
    {
        "name": "item",
        "type":"item",
        "settings": [
            {
                "type": "image_picker",
                "label": "icon",
                "id":"icon"
            },
            {
                "type": "range",
                "id": "max_width",
                "min": 150,
                "max": 300,
                "step": 2,
                "unit": "px",
                "label": "max-width logo",
                "default": 280
            },
            {
                "type": "range",
                "id": "max_height",
                "min": 50,
                "max": 300,
                "step": 5,
                "unit": "px",
                "label": "max-width logo",
                "default": 280
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Section marquee",
      "category":"Home page"
      
    }
  ]
}
{% endschema %}
