{{ 'section-banner.css' |  asset_url |  stylesheet_tag }}


<div class="section-banner  color-{{ section.settings.color_scheme }}">
    {% if section.settings.img != blank %}
        <picture>
            {% if section.settings.img_m != blank %}
            <source
                media="(max-width: 500px)"
                srcset="
                {{ section.settings.img_m | image_url: width: 375 }} 375w,
                {{ section.settings.img_m | image_url: width: 500 }} 500w,
                {{ section.settings.img_m | image_url: width: 750 }} 750w
                "
                sizes="100vw"
            >
            {% endif %}

            <img
            class="bg"
            src="{{ section.settings.img | image_url: width: 1600 }}"
            srcset="
                {{ section.settings.img | image_url: width: 750 }} 750w,
                {{ section.settings.img | image_url: width: 1200 }} 1200w,
                {{ section.settings.img | image_url: width: 1600 }} 1600w,
                {{ section.settings.img | image_url: width: 2200 }} 2200w
            "
            sizes="100vw"
            width="{{ section.settings.img.width }}"
            height="{{ section.settings.img.height }}"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            alt="{{ section.settings.img.alt | escape }}"
            >
        </picture>
    {% endif %}
    <div class="container">
        <div class="section-banner__wrap">
            <div class="title">
                <h1 class="h1">
                    {{ section.settings.title }}
                </h1>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Section banner",
  "tag": "section",
  "class": "section new-shopify-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "color scheme",
      "default": "scheme-1"
    },
    {
        "type": "image_picker",
        "id":"img",
        "label":"background image"
    },
    {
        "type": "image_picker",
        "id":"img_m",
        "label":"background image mobile"
    },
    {
        "type": "text",
        "id":"title",
        "label": "title",
        "default": "HOME OF THE TOP TEN"
    }
  
  ],
  "presets": [
    {
      "name": "Section banner"
    }
  ]
}
{% endschema %}