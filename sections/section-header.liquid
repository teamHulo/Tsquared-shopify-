{{ 'section-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo_render_width = section.settings.logo_width
  assign logo_image_width = logo_render_width | times: 2

  if section.settings.logo != blank and logo_image_width > section.settings.logo.width
    assign logo_image_width = section.settings.logo.width
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<header
  class="header color-{% if request.page_type == 'index' %}{{ section.settings.color_scheme_home_top }}{% else %}{{ section.settings.color_scheme }}{% endif %}"
  data-header-color-scheme="{{ section.settings.color_scheme }}"
  data-home-top-color-scheme="{{ section.settings.color_scheme_home_top }}"
  data-drawer-color-scheme="{{ section.settings.color_scheme_drawer }}"
  data-is-home="{% if request.page_type == 'index' %}true{% else %}false{% endif %}"
>
  <div class="header__body">
    <div class="container">
      <div class="header__wrap section-{{ section.id }}-padding">

        <button
          type="button"
          class="header-burger"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="HeaderDrawer-{{ section.id }}"
        >
          <svg
            width="36"
            height="19"
            viewBox="0 0 36 19"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <line y1="0.5" x2="36" y2="0.5" stroke="currentColor"/>
            <line y1="9.33019" x2="36" y2="9.33019" stroke="currentColor"/>
            <line y1="18.1604" x2="36" y2="18.1604" stroke="currentColor"/>
          </svg>
        </button>

        <div class="logo">
          <a
            href="{{ routes.root_url }}"
            class="logo__link"
            aria-label="{{ shop.name | escape }}"
          >
            {% if section.settings.logo != blank %}
              <span
                class="logo__mask"
                aria-hidden="true"
                style="
                  --logo-url: url('{{ section.settings.logo | image_url: width: logo_image_width }}');
                  width: {{ section.settings.logo_width }}px;
                  aspect-ratio: {{ section.settings.logo.aspect_ratio }};
                "
              ></span>
            {% else %}
              <span>{{ shop.name }}</span>
            {% endif %}
          </a>
        </div>

        <div class="icons">
          <a
            href="#swym-wishlist"
            class="swym-wishlist"
            aria-label="Wishlist"
          >
            <i
              aria-hidden="true"
              focusable="false"
              role="presentation"
              class="fa fa-heart"
            ></i>
          </a>
        </div>

      </div>
    </div>

    <header-drawer
      id="HeaderDrawer-{{ section.id }}"
      class="header-drawer color-{{ section.settings.color_scheme_drawer }}"
    >
      <div class="header-drawer__wrap">
        <div class="container">

          {% if section.settings.menu != blank %}
            <nav class="header-drawer__nav">
              <ul class="header-drawer__menu" role="list">

                {% for link in section.settings.menu.links %}
                  <li class="header-drawer__menu-item{% if link.links != blank %} has-submenu{% endif %}">

                    <a
                      href="{{ link.url }}"
                      class="header-drawer__menu-link"
                    >
                      {{ link.title }}
                    </a>

                    {% if link.links != blank %}
                      <ul class="header-drawer__submenu" role="list">

                        {% for child_link in link.links %}
                          <li class="header-drawer__submenu-item{% if child_link.links != blank %} has-submenu{% endif %}">

                            <a
                              href="{{ child_link.url }}"
                              class="header-drawer__submenu-link"
                            >
                              {{ child_link.title }}
                            </a>

                            {% if child_link.links != blank %}
                              <ul
                                class="header-drawer__submenu header-drawer__submenu--child"
                                role="list"
                              >

                                {% for grandchild_link in child_link.links %}
                                  <li class="header-drawer__submenu-item">
                                    <a
                                      href="{{ grandchild_link.url }}"
                                      class="header-drawer__submenu-link"
                                    >
                                      {{ grandchild_link.title }}
                                    </a>
                                  </li>
                                {% endfor %}

                              </ul>
                            {% endif %}

                          </li>
                        {% endfor %}

                      </ul>
                    {% endif %}

                  </li>
                {% endfor %}

              </ul>
            </nav>
          {% endif %}

          {% if section.settings.drawer_img != blank %}
            <div class="image">
              <div class="image__wrap">

                {{
                  section.settings.drawer_img
                  | image_url: width: 1200
                  | image_tag:
                    widths: '320, 480, 640, 800, 1000, 1200',
                    sizes: '(min-width: 1000px) 600px, (min-width: 750px) 50vw, 100vw',
                    loading: 'lazy',
                    fetchpriority: 'low',
                    alt: section.settings.drawer_img.alt
                }}

              </div>
            </div>
          {% endif %}

        </div>
      </div>
    </header-drawer>

  </div>
</header>

<script>
class HeaderDrawer extends HTMLElement {
  constructor() {
    super();

    this.section = this.closest('.shopify-section');
    this.header = this.section?.querySelector('.header');
    this.burger = this.section?.querySelector('.header-burger');

    this.headerScheme = this.header?.dataset.headerColorScheme;
    this.homeTopScheme = this.header?.dataset.homeTopColorScheme;
    this.drawerScheme = this.header?.dataset.drawerColorScheme;
    this.isHome = this.header?.dataset.isHome === 'true';

    this.onBurgerClick = this.onBurgerClick.bind(this);
    this.onKeydown = this.onKeydown.bind(this);
    this.onScroll = this.onScroll.bind(this);
    this.onDocumentClick = this.onDocumentClick.bind(this);
  }

  connectedCallback() {
    if (!this.burger) return;

    this.burger.addEventListener('click', this.onBurgerClick);
    document.addEventListener('keydown', this.onKeydown);
    document.addEventListener('click', this.onDocumentClick);
    window.addEventListener('scroll', this.onScroll, { passive: true });

    this.updateHeaderAppearance();
  }

  disconnectedCallback() {
    this.burger?.removeEventListener('click', this.onBurgerClick);
    document.removeEventListener('keydown', this.onKeydown);
    document.removeEventListener('click', this.onDocumentClick);
    window.removeEventListener('scroll', this.onScroll);
  }

  setHeaderScheme(scheme) {
    if (!this.header || !scheme) return;

    Array.from(this.header.classList)
      .filter((className) => className.startsWith('color-'))
      .forEach((className) => {
        this.header.classList.remove(className);
      });

    this.header.classList.add(`color-${scheme}`);
  }

  updateHeaderAppearance() {
    if (!this.header) return;

    const isAtTop = window.scrollY <= 1;
    const drawerIsOpen = this.classList.contains('is-open');

    this.header.classList.toggle(
      'is-at-top',
      this.isHome && isAtTop
    );

    if (drawerIsOpen) {
      this.setHeaderScheme(this.drawerScheme);
      return;
    }

    if (this.isHome && isAtTop) {
      this.setHeaderScheme(this.homeTopScheme);
      return;
    }

    this.setHeaderScheme(this.headerScheme);
  }

  open() {
    this.classList.add('is-open');
    this.header?.classList.add('drawer-is-open');
    this.burger.classList.add('is-active');

    this.setHeaderScheme(this.drawerScheme);

    this.burger.setAttribute('aria-expanded', 'true');
    this.burger.setAttribute('aria-label', 'Close menu');

    document.body.classList.add('header-drawer-open');
  }

  close() {
    this.classList.remove('is-open');
    this.header?.classList.remove('drawer-is-open');
    this.burger.classList.remove('is-active');

    this.burger.setAttribute('aria-expanded', 'false');
    this.burger.setAttribute('aria-label', 'Open menu');

    document.body.classList.remove('header-drawer-open');

    this.updateHeaderAppearance();
  }

  toggle() {
    if (this.classList.contains('is-open')) {
      this.close();
    } else {
      this.open();
    }
  }

  onBurgerClick() {
    this.toggle();
  }

  onDocumentClick(event) {
    if (!this.classList.contains('is-open')) return;

    if (this.header?.contains(event.target)) return;

    this.close();
  }

  onKeydown(event) {
    if (
      event.key === 'Escape' &&
      this.classList.contains('is-open')
    ) {
      this.close();
    }
  }

  onScroll() {
    this.updateHeaderAppearance();
  }
}

if (!customElements.get('header-drawer')) {
  customElements.define('header-drawer', HeaderDrawer);
}
</script>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section new-shopify-section section-header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Header color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_home_top",
      "label": "Homepage top color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_drawer",
      "label": "Drawer color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 180
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "image_picker",
      "id": "drawer_img",
      "label": "Drawer image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}